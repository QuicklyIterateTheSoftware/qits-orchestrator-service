{
  "consumer": {
    "name": "qits-orchestrator-service"
  },
  "interactions": [
    {
      "comments": {
        "references": {
          "qits-call": {
            "app": "qits-idp-service",
            "operationId": "collectServiceClients"
          },
          "qits-trigger": {
            "app": "qits-orchestrator-service",
            "kind": "schedule",
            "schedule": "GcSchedule.onSchedule"
          }
        }
      },
      "description": "GcSchedule.onSchedule: collectServiceClients",
      "key": "50fab4f3",
      "pending": false,
      "providerStates": [
        {
          "name": "a service client nothing claims, calling with its bearer",
          "params": {
            "authorization": "Bearer ",
            "callerClientId": "test-broad",
            "claimedClientId": "contract-claimed-00000002",
            "unclaimedClientId": "contract-unclaimed-00000002"
          }
        }
      ],
      "request": {
        "body": {
          "content": {
            "claims": [
              {
                "applicationName": "contract",
                "clientId": "contract-claimed-00000002"
              }
            ],
            "dryRun": false
          },
          "contentType": "application/json",
          "encoded": false
        },
        "generators": {
          "body": {
            "$.claims[0].clientId": {
              "dataType": "STRING",
              "expression": "${claimedClientId}",
              "type": "ProviderState"
            }
          },
          "header": {
            "Authorization": {
              "dataType": "RAW",
              "expression": "${authorization}",
              "type": "ProviderState"
            }
          }
        },
        "headers": {
          "Authorization": [
            "Bearer "
          ],
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.claims[0].clientId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/idp/api/gc/service-clients"
      },
      "response": {
        "body": {
          "content": {
            "dryRun": false,
            "kept": [
              {},
              {},
              {},
              {},
              {}
            ],
            "keptCounts": {
              "caller": 0,
              "claimed": 1,
              "grace": 4
            },
            "removed": [
              {
                "clientId": "contract-unclaimed-00000002"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.dryRun": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.kept": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "max": 5,
                  "min": 5
                }
              ]
            },
            "$.keptCounts.caller": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.keptCounts.claimed": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.keptCounts.grace": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.removed": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "max": 1,
                  "min": 1
                }
              ]
            },
            "$.removed[*].clientId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
