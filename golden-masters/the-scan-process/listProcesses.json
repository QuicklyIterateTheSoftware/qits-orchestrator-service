[
  {
    "kind": "gc",
    "name": "Garbage collection",
    "description": "Reads the platform's pin set once, then asks every store's own owner to delete what nothing pins: registry identities and blobs (qits-artifacts), host images, orphan volumes and buildkit cache (qits-containers), service clients nothing claims (qits-idp), and mirrored images no manifest pins (qits-mirror). Measures host disk and the registry store before and after.",
    "dryRunnable": true,
    "steps": [
      {
        "id": "usage.before",
        "name": "Disk usage before",
        "target": "containers",
        "dependsOn": []
      },
      {
        "id": "artifacts.usage.before",
        "name": "Registry store before",
        "target": "artifacts",
        "dependsOn": []
      },
      {
        "id": "pins.deployments",
        "name": "Deployment pins",
        "target": "deployments",
        "dependsOn": []
      },
      {
        "id": "pins.ci",
        "name": "CI daemon pin",
        "target": "ci",
        "dependsOn": []
      },
      {
        "id": "pins.dependencies",
        "name": "Dependency pins",
        "target": "maintenance",
        "dependsOn": []
      },
      {
        "id": "pins.workspaces",
        "name": "Workspace launch pins",
        "target": "workspaces",
        "dependsOn": []
      },
      {
        "id": "pins.projects",
        "name": "Project launch pins",
        "target": "projects",
        "dependsOn": []
      },
      {
        "id": "pins.mirror-images",
        "name": "Mirror image pins",
        "target": "maintenance",
        "dependsOn": []
      },
      {
        "id": "artifacts.plan",
        "name": "Plan the registry collection",
        "target": "artifacts",
        "dependsOn": [
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects"
        ]
      },
      {
        "id": "artifacts.sweep",
        "name": "Sweep the registry",
        "target": "artifacts",
        "dependsOn": [
          "artifacts.plan",
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects"
        ]
      },
      {
        "id": "containers.images",
        "name": "Collect host images",
        "target": "containers",
        "dependsOn": [
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects"
        ]
      },
      {
        "id": "containers.volumes",
        "name": "Collect orphan volumes",
        "target": "containers",
        "dependsOn": [
          "usage.before",
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects"
        ]
      },
      {
        "id": "containers.build-cache",
        "name": "Prune the build cache",
        "target": "containers",
        "dependsOn": [
          "usage.before",
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects"
        ]
      },
      {
        "id": "repos.catalogue",
        "name": "Repository catalogue",
        "target": "projects",
        "dependsOn": []
      },
      {
        "id": "branches.sweep",
        "name": "Sweep merged branches",
        "target": "workspaces",
        "dependsOn": [
          "repos.catalogue",
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects"
        ]
      },
      {
        "id": "tags.sweep",
        "name": "Decommissioned git tags",
        "target": "projects",
        "dependsOn": [
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects",
          "repos.catalogue"
        ]
      },
      {
        "id": "claims.idp-clients",
        "name": "Service-client claims",
        "target": "deployments",
        "dependsOn": []
      },
      {
        "id": "idp.service-clients",
        "name": "Unclaimed service clients",
        "target": "idp",
        "dependsOn": [
          "claims.idp-clients",
          "pins.deployments",
          "pins.ci",
          "pins.dependencies",
          "pins.workspaces",
          "pins.projects"
        ]
      },
      {
        "id": "mirror.sweep",
        "name": "Evict the mirror",
        "target": "mirror",
        "dependsOn": []
      },
      {
        "id": "artifacts.usage.after",
        "name": "Registry store after",
        "target": "artifacts",
        "dependsOn": [
          "artifacts.sweep"
        ]
      },
      {
        "id": "usage.after",
        "name": "Disk usage after",
        "target": "containers",
        "dependsOn": [
          "artifacts.sweep",
          "containers.images",
          "containers.volumes",
          "containers.build-cache"
        ]
      }
    ]
  },
  {
    "kind": "sbom-check",
    "name": "SBOM check",
    "description": "Asks qits-maintenance to check every released version still in the registry for a usable SBOM, re-read the ones that are missing or failed, and keep one ticket open per artifact that still has none. Reports the versions without one, the open tickets and any warnings.",
    "dryRunnable": false,
    "steps": [
      {
        "id": "check",
        "name": "Check the SBOMs",
        "target": "maintenance",
        "dependsOn": []
      }
    ]
  },
  {
    "kind": "scan",
    "name": "Manifest scan",
    "description": "Asks qits-maintenance to re-scan every repository's manifests and refresh the latest versions: first the platform's own artifacts (INTERNAL), then everything published elsewhere (EXTERNAL), each followed until it ends. Bumps nothing — what is out of date is what the next release request's pre-run bumps.",
    "dryRunnable": false,
    "steps": [
      {
        "id": "internal.request",
        "name": "Request the internal scan",
        "target": "maintenance",
        "dependsOn": []
      },
      {
        "id": "internal.follow",
        "name": "Follow the internal scan",
        "target": "maintenance",
        "dependsOn": [
          "internal.request"
        ]
      },
      {
        "id": "external.request",
        "name": "Request the external scan",
        "target": "maintenance",
        "dependsOn": []
      },
      {
        "id": "external.follow",
        "name": "Follow the external scan",
        "target": "maintenance",
        "dependsOn": [
          "external.request"
        ]
      }
    ]
  }
]
