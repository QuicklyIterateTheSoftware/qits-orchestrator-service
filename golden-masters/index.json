{
  "formatVersion": 1,
  "provider": "qits-orchestrator",
  "states": [
    {
      "name": "a finished gc dry run",
      "slug": "a-finished-gc-dry-run",
      "params": {
        "kind": "gc",
        "runId": "00000000-0000-4000-8000-000000000001"
      },
      "dependsOn": [],
      "operations": [
        {
          "operationId": "run",
          "method": "GET",
          "path": "/orchestrator/api/runs/{runId}",
          "status": 200,
          "file": "a-finished-gc-dry-run/run.json",
          "frozen": {
            "ids": [
              "$.id"
            ],
            "instants": [
              "$.startedAt",
              "$.finishedAt",
              "$.steps[*].startedAt",
              "$.steps[*].finishedAt"
            ],
            "strings": [],
            "listFilteredTo": null
          }
        },
        {
          "operationId": "runs",
          "method": "GET",
          "path": "/orchestrator/api/processes/{kind}/runs",
          "status": 200,
          "file": "a-finished-gc-dry-run/runs.json",
          "frozen": {
            "ids": [
              "$[*].id"
            ],
            "instants": [
              "$[*].startedAt",
              "$[*].finishedAt"
            ],
            "strings": [],
            "listFilteredTo": "$"
          }
        }
      ]
    },
    {
      "name": "a repository the cleanup can plan",
      "slug": "a-repository-the-cleanup-can-plan",
      "params": {
        "repository": "daemons"
      },
      "dependsOn": [],
      "operations": [
        {
          "operationId": "listArtifactsCleanupRepositories",
          "method": "GET",
          "path": "/orchestrator/api/artifacts/repositories",
          "status": 200,
          "file": "a-repository-the-cleanup-can-plan/listArtifactsCleanupRepositories.json",
          "frozen": {
            "ids": [],
            "instants": [
              "$.generatedAt"
            ],
            "strings": [],
            "listFilteredTo": null
          }
        },
        {
          "operationId": "planArtifactsCleanupRepository",
          "method": "GET",
          "path": "/orchestrator/api/artifacts/repositories/{repository}/plan",
          "status": 200,
          "file": "a-repository-the-cleanup-can-plan/planArtifactsCleanupRepository.json",
          "frozen": {
            "ids": [],
            "instants": [
              "$.generatedAt",
              "$.pins[*].readAt"
            ],
            "strings": [],
            "listFilteredTo": null
          }
        },
        {
          "operationId": "sweepArtifactsCleanupRepository",
          "method": "POST",
          "path": "/orchestrator/api/artifacts/repositories/{repository}/sweep",
          "status": 200,
          "file": "a-repository-the-cleanup-can-plan/sweepArtifactsCleanupRepository.json",
          "frozen": {
            "ids": [],
            "instants": [
              "$.executedAt",
              "$.pins[*].readAt"
            ],
            "strings": [],
            "listFilteredTo": null
          }
        }
      ]
    },
    {
      "name": "no active gc run",
      "slug": "no-active-gc-run",
      "params": {
        "kind": "gc"
      },
      "dependsOn": [],
      "operations": [
        {
          "operationId": "start",
          "method": "POST",
          "path": "/orchestrator/api/processes/{kind}/runs",
          "body": {
            "dryRun": true
          },
          "status": 202,
          "file": "no-active-gc-run/start.json",
          "frozen": {
            "ids": [
              "$.id"
            ],
            "instants": [],
            "strings": [],
            "listFilteredTo": null
          }
        }
      ]
    },
    {
      "name": "the gc process",
      "slug": "the-gc-process",
      "params": {
        "kind": "gc"
      },
      "dependsOn": [],
      "operations": [
        {
          "operationId": "processes",
          "method": "GET",
          "path": "/orchestrator/api/processes",
          "status": 200,
          "file": "the-gc-process/processes.json",
          "frozen": {
            "ids": [],
            "instants": [],
            "strings": [],
            "listFilteredTo": null
          }
        }
      ]
    }
  ]
}
